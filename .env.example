# Copy to .env and fill in. docker compose and backend/rag/config.py both read .env automatically.

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=low

# ---------- Neo4j ----------
# Option A - Neo4j Aura (cloud): paste the values from the credentials file Aura gives you.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<username>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=<database>          # Aura Free: same as the instance id; self-hosted: neo4j
# Option B - local Neo4j container: comment out NEO4J_URI above, set a password (min 8 chars)
# and start with:  docker compose --profile local-neo4j up --build
# Option C - no Neo4j: set NEO4J_URI= (empty); the graph is kept in data/index/graph.json only.

# Graph queries (GraphRAG traversal + graph explorer): neo4j (Cypher, default) or networkx (in-memory)
# GRAPH_QUERY_ENGINE=neo4j
